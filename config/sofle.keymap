#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {

   // Activate ADJUST layer by pressing raise and lower
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
// ---------------------------------------------------------------------------------------------------------
// | ESC  |  1  |  2  |  3  |  4  |  5  |                     |  6   |  7   |  8   |  9   |  0   |  `   |
// | TAB  |  Q  |  W  |  E  |  R  |  T  |                     |  Y   |  U   |  I   |  O   |  P   | BSPC |
// | CTRL |  A  |  S  |  D  |  F  |  G  |                     |  H   |  J   |  K   |  L   |  ;   |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  | MUTE  |  ---        |  N   |  M   |  ,   |  .   |  /   |  -   |
//              | ALT | ALT | GUI |RAISE| SPACE |  ENTER      |LOWER | RALT | SHFT | SHFT |
// ---------------------------------------------------------------------------------------------------------
            bindings = <
&kp ESC   &kp N1    &kp N2   &kp N3   &kp N4    &kp N5                      &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp GRAVE
&kp TAB   &kp Q     &kp W    &kp E    &kp R     &kp T                       &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSPC
&kp LCTRL &kp A     &kp S    &kp D    &kp F     &kp G                       &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
&kp LSHFT &kp Z     &kp X    &kp C    &kp V     &kp B     &kp C_MUTE &none  &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp MINUS
                    &kp LALT &kp LALT &kp LGUI  &mo RAISE &kp SPC    &kp RET &mo LOWER &kp RALT &kp RSHFT &kp RSHFT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "lower";
// ---------------------------------------------------------------------------------------------------------
// | ESC  |  F1  |  F2  |  F3  |  F4  |  F5   |                   |  F6  |  F7  |  F8  |  F9  |  F10  |  F11  |
// |  `   |  1   |  2   |  3   |  4   |  5    |                   |  6   |  7   |  8   |  9   |  0    | BSPC  |
// | TRNS | ---  | ---  | ---  |SCRL^ | PGUP  |                   | LEFT | DOWN |  UP  |RIGHT | ---   | DEL   |
// | TRNS | ---  | ---  | ---  |SCRLv | PGDN  | TRNS  | TRNS      | ---  | ---  | ---  | ---  | LANG2 | LANG1 |
//               | TRNS | TRNS | TRNS | TRNS  | TRNS  | TRNS      | TRNS | TRNS | TRNS | TRNS |
// ---------------------------------------------------------------------------------------------------------
            bindings = <
&kp ESC   &kp F1 &kp F2 &kp F3 &kp F4         &kp F5                   &kp F6    &kp F7    &kp F8 &kp F9    &kp F10   &kp F11
&kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4         &kp N5                   &kp N6    &kp N7    &kp N8 &kp N9    &kp N0    &kp BSPC
&trans    &none  &none  &none  &msc SCRL_UP   &kp PG_UP                &kp LEFT  &kp DOWN  &kp UP &kp RIGHT &none     &kp DEL
&trans    &none  &none  &none  &msc SCRL_DOWN &kp PG_DN &trans &trans  &none     &none     &none  &none     &kp LANG2 &kp LANG1
                 &trans &trans &trans         &trans    &trans &trans  &trans    &trans    &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "raise";
// ---------------------------------------------------------------------------------------------------------
// | TRNS | TRNS   | TRNS      | TRNS     | TRNS     | TRNS  |                   | TRNS |  TRNS |  TRNS |  TRNS |  TRNS |  TRNS |
// | ESC  |  !     |  @        |  #       |  $       |  %    |                   |  ^   |   &   |   *   |   (   |   )   | BSPC  |
// | TRNS | SFT+F6 | SCRN FULL | SCRN WIN | GUI FIND | CTRL^ |                   |  +   |   =   |   {   |   }   |   :   |   "   |
// | TRNS | UNDO   | CUT       | COPY     | PASTE    | CTRLv | TRNS  | TRNS      |  \   |   `   |   [   |   ]   |   ?   |   _   |
//               |BT NEXT| BT CLR   | TRNS     | TRNS  | TRNS  | TRNS      | TRNS |  TRNS |  TRNS |  TRNS |
// ---------------------------------------------------------------------------------------------------------
            bindings = <
&trans  &trans     &trans             &trans         &trans      &trans                        &trans      &trans    &trans    &trans    &trans       &trans
&kp ESC &kp EXCL   &kp AT             &kp HASH       &kp DLLR    &kp PRCNT                     &kp CARET   &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR     &kp BSPC
&trans  &kp LS(F6) &kp LS(LC(LG(N4))) &kp LS(LG(N4)) &kp LG(F)   &kp LC(UP)                    &kp KP_PLUS &kp EQL   &kp LBRC  &kp RBRC  &kp COLON    &kp DQT
&trans  &kp K_UNDO &kp K_CUT          &kp K_COPY     &kp K_PASTE &kp LC(DOWN) &trans    &trans &kp BSLH    &kp GRAVE &kp LBKT  &kp RBKT  &kp LS(FSLH) &kp LS(MINUS)
                   &bt BT_NXT         &bt BT_CLR     &trans      &trans       &trans    &trans &trans      &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            display-name = "adjust";
// ---------------------------------------------------------------------------------------------------------
// | ---     | ---  | ---  | LCA+E | LCA+R | LCA+T |                 | ---   | ---   | ---   | ---     | ---     | --- |
// | RGB TOG | ---  | ---  | LCA+D | LCA+F | LCA+G |                 | LCA+U | LCA+I | PLAY  | PREV    | NEXT    | --- |
// | RGB EFR | HUE+ | SAT+ | BRI+  | ---   | ---   |                 | LCA<- | LCAv  | LCA^  | LCA->   | LCA+ENT | --- |
// | RGB EFF | HUE- | SAT- | BRI-  | ---   | ---   | ---   | ---     | LCA+J | LCA+K | ---   | ---     | ---     | --- |
//                  | ---  | ---   | ---   | ---   | ---   | ---     | ---   | ---   | ---   | ---     |
// ---------------------------------------------------------------------------------------------------------
            bindings = <
&none           &none           &none           &kp LC(LA(E)) &kp LC(LA(R)) &kp LC(LA(T))                &none            &none            &none            &none            &none            &none
&rgb_ug RGB_TOG &none           &none           &kp LC(LA(D))   &kp LC(LA(F)) &kp LC(LA(G))                &kp LC(LA(U))    &kp LC(LA(I))    &kp C_PLAY_PAUSE &kp C_PREV       &kp C_NEXT       &none
&rgb_ug RGB_EFR &rgb_ug RGB_HUI &rgb_ug RGB_SAI &rgb_ug RGB_BRI &none         &none                        &kp LC(LA(LEFT)) &kp LC(LA(DOWN)) &kp LC(LA(UP))   &kp LC(LA(RIGHT)) &kp LC(LA(RET)) &none
&rgb_ug RGB_EFF &rgb_ug RGB_HUD &rgb_ug RGB_SAD &rgb_ug RGB_BRD &none         &none         &none   &none  &kp LC(LA(J))    &kp LC(LA(K))    &none            &none            &none            &none
                                &none           &none           &none         &none         &none   &none  &none            &none            &none            &none
            >;
        };

    };
};
